# --- machine-specific (regenerated on every bootstrap / SessionStart) ---
machine-profile.json

# --- Claude Code residues ---
.claude/worktrees/
.claude/settings.local.json
tmpclaude-*

# --- data layers never enter git (resolved by hash from tinkuy-qhali-registry) ---
# raw/: bytes are ignored, but the DVC pointer files and manifests that identify them are tracked.
raw/**
!raw/**/
!raw/**/*.dvc
!raw/**/manifest.json
!raw/**/manifest.sha256
standardized/
harmonized/
marts/
quarantine/
*.parquet
*.duckdb
*.duckdb.wal

# --- caches & environments ---
.Rproj.user/
.Rhistory
.RData
renv/library/
renv/staging/
renv/local/
.venv/
__pycache__/
*.pyc
_targets/
.dvc/cache/
.dvc/tmp/
.dvc/config.local
.quarto/
_site/
/site_libs/

# --- secrets ---
.env
.env.*
*.pem

/.quarto/
**/*.quarto_ipynb
_site/
